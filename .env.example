# 配置模板：复制为 .env 本地使用，或直接在系统环境变量中设置
# 敏感值（API Key、数据库密码）请通过系统环境变量注入，不要写在这里

# 应用配置
APP_NAME=安心保
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# 日志配置
LOGGING_LEVEL=INFO

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=

# 模型配置（API Key 必须通过系统环境变量设置，禁止提交真实值）
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
